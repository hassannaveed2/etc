# Copy to .env.local and fill in. Never commit .env.local.

# MySQL (DigitalOcean managed)
DB_HOST=
DB_PORT=25060
DB_USER=
DB_PASSWORD=
DB_NAME=ETC
DB_SSLMODE=REQUIRED

# DigitalOcean Spaces (S3-compatible). All ETC media lives under the ETC/ prefix.
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=sbsi-cdn
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_BASE=https://sbsi-cdn.sgp1.digitaloceanspaces.com
